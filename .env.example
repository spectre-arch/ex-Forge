# ExForge Configuration Template
# NOTE: Never commit your real .env file with secrets!

# Provider choice: "groq" (Fast cloud inference for Gemma/Llama) or "ollama" (Local offline inference)
LLM_PROVIDER=groq

# Groq API Key (Free tier at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Open-weight Model Selection:
# - gemma2-9b-it (Google Gemma 2 - High accuracy & instruction following)
# - llama-3.1-8b-instant (Meta Llama 3.1 - Fast reasoning)
DEFAULT_MODEL=gemma2-9b-it

# Local Ollama URL (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Optional: GitHub Personal Access Token
# Public repos work without a token; a token simply increases the GitHub API rate limit from 60 to 5,000 requests/hr.
GITHUB_TOKEN=
